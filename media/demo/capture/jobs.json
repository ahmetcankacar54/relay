  "eval":"(() => { const card = __find('text:forecast').closest('[class*=\"@container\"]'); let hidden = 0; const tracks = [...card.querySelectorAll('.bg-track')]; const rows = tracks.map(t => { const r = t.getBoundingClientRect(); return [Math.round(r.x), Math.round(r.y), Math.round(r.width), Math.round(r.height)]; }); for (const t of tracks) { if (t.querySelector('[class*=\"bg-brand/20\"]')) continue; for (const c of t.children) { const cls = String(c.className); if (/(^|\\s)bg-foreground(\\s|$)/.test(cls)) continue; c.style.visibility = 'hidden'; hidden++; } } return { hidden, rows }; })()"},
