{
  "name": "relay-workspace",
  "productName": "Relay",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "description": "A local desktop workspace for multiple Claude Code accounts and durable session history.",
  "scripts": {
    "dev": "tauri dev",
    "dev:ui": "vite --host 127.0.0.1",
    "icons": "node scripts/icon.mjs && node --import tsx scripts/mascot.ts",
    "mascot": "node --import tsx scripts/mascot.ts",
    "mascot:placeholders": "node --import tsx scripts/mascot-placeholders.ts",
    "i18n:widget": "node --import tsx scripts/i18n/widget-strings.ts",
    "build": "tauri build",
    "build:ui": "tsc --noEmit && vite build",
    "build:native": "node scripts/build-native.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "preflight:live": "node --import tsx scripts/live-preflight.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:desktop": "cargo test -p relay-app --features smoke",
    "test:boot": "node scripts/smoke-boot.mjs",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "perf:idle": "node scripts/perf-idle.mjs",
    "check:mac-signing": "node scripts/check-macos-signing.mjs",
    "dist:mac:local": "node scripts/stable-signing.mjs",
    "install:mac": "node scripts/stable-signing.mjs --install",
    "dist:mac:share": "node scripts/stable-signing.mjs --dmg --arch both --output release/share",
    "dist": "node scripts/tauri-build.mjs",
    "release": "node scripts/publish-release.mjs",
    "format": "prettier --write src shared tests scripts",
    "format:check": "node scripts/format-check.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/api": "2.12.5",
    "@tauri-apps/cli": "2.12.6",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "intl-messageformat": "^12.2.0",
    "lucide-react": "^0.468.0",
    "prettier": "^3.9.10",
    "radix-ui": "1.6.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-is": "^19.2.0",
    "recharts": "3.8.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.20.0",
    "tw-animate-css": "1.4.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.73.0",
    "vite": "^7.3.0",
    "zod": "^4.1.0"
  }
}
