{
  "name": "relay-workspace",
  "productName": "Relay",
  "version": "0.18.1",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "description": "A local desktop workspace for multiple Claude Code accounts and durable session history.",
  "main": "dist-electron/entry.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:ui": "vite --host 127.0.0.1",
    "icons": "node scripts/icon.mjs && node --import tsx scripts/mascot.ts",
    "mascot": "node --import tsx scripts/mascot.ts",
    "mascot:placeholders": "node --import tsx scripts/mascot-placeholders.ts",
    "build": "tsc --noEmit && vite build && node scripts/build.mjs",
    "build:cli": "node scripts/build-cli.mjs",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "preflight:live": "node --import tsx scripts/live-preflight.ts",
    "test:continuation": "node --import tsx scripts/continuation-lab.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:desktop": "node scripts/smoke.mjs",
    "check:mac-signing": "node scripts/check-macos-signing.mjs",
    "dist:mac:local": "node scripts/stable-signing.mjs",
    "install:mac": "node scripts/stable-signing.mjs --install",
    "dist:mac:share": "node scripts/stable-signing.mjs --dmg --arch both --output release/share",
    "dist": "node scripts/dist.mjs",
    "release": "node scripts/publish-release.mjs",
    "postinstall": "electron-builder install-app-deps",
    "format": "prettier --write src electron shared tests scripts"
  },
  "dependencies": {
    "classic-level": "3.0.0",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/manrope": "^5.2.8",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "electron": "^44.7.0",
    "electron-builder": "^26.0.12",
    "electron-updater": "6.8.11",
    "esbuild": "^0.25.0",
    "lucide-react": "^0.468.0",
    "prettier": "^3.9.10",
    "radix-ui": "1.6.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.5",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.20.0",
    "tw-animate-css": "1.4.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0",
    "zod": "^4.1.0"
  },
  "overrides": {
    "global-agent": "^4.1.3"
  },
  "build": {
    "appId": "dev.relay.workspace",
    "productName": "Relay",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "dist-electron/**/*",
      "!dist-electron/**/*.map",
      "!dist-electron/RelayWidget.appex/**",
      "package.json"
    ],
    "protocols": [
      {
        "name": "Relay",
        "schemes": [
          "relay"
        ]
      }
    ],
    "electronLanguages": [
      "en",
      "tr"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**/*",
      "node_modules/classic-level/**/*",
      "dist-electron/desktop-automation",
      "dist-electron/widget-center.node"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "mac": {
      "identity": "-",
      "extraFiles": [
        {
          "from": "dist-electron/RelayWidget.appex",
          "to": "PlugIns/RelayWidget.appex"
        }
      ],
      "icon": "assets/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ahmetcankacar54",
        "repo": "relay"
      }
    ],
    "win": {
      "artifactName": "Relay-Setup-${version}-x64.${ext}",
      "icon": "assets/icon.png",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "artifactName": "Relay-${version}-x86_64.${ext}",
      "icon": "assets/icon.png",
      "target": [
        "AppImage"
      ],
      "category": "Development"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
